      "method": "get",
      "endpoint": "orders",
      "responses": [
        {
          "uuid": "a1b2c3d4-0002-4000-8000-000000000001",
          "body": "{\n  \"note\": \"Mockoon 只檢查 Authorization header 的格式並解析 JWT payload，不會驗證簽章。真正的簽章驗證請看 resource-server。\",\n  \"requested_by\": \"{{jwtPayload (header 'Authorization') 'preferred_username'}}\",\n  \"subject\": \"{{jwtPayload (header 'Authorization') 'sub'}}\",\n  \"audience\": {{{stringify (jwtPayload (header 'Authorization') 'aud')}}},\n  \"groups\": {{{stringify (jwtPayload (header 'Authorization') 'groups')}}},\n  \"orders\": [\n    { \"id\": 1001, \"item\": \"Keyboard\", \"amount\": 1200, \"status\": \"SHIPPED\" },\n    { \"id\": 1002, \"item\": \"Monitor\", \"amount\": 6800, \"status\": \"PROCESSING\" },\n    { \"id\": 1003, \"item\": \"USB-C Cable\", \"amount\": 350, \"status\": \"DELIVERED\" }\n  ]\n}",
          "latency": 0,
          "statusCode": 200,
          "label": "有 Bearer token -> 回傳訂單",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "bodyType": "INLINE",
          "filePath": "",
          "databucketID": "",
          "sendFileAsBody": false,
          "rules": [
            {
              "target": "header",
              "modifier": "Authorization",
              "value": "^Bearer .+",
              "invert": false,
              "operator": "regex"
            }
          ],
          "rulesOperator": "OR",
          "disableTemplating": false,
          "fallbackTo404": false,
          "default": false,
          "crudKey": "id",
          "callbacks": []
        },
